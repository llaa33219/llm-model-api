{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-model-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "containers": [
    {
      "name": "llm-model-api-dialect-detector-durable",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./container/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DIALECT_DETECTOR",
        "class_name": "DialectDetectorDurableContainer"
      }
    ]
  },
  "exports": {
    "DialectDetectorContainer": {
      "type": "durable-object",
      "state": "deleted"
    },
    "DialectDetectorDurableContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "llm-model-api-dialect-detector-durable"
    }
  },
  "routes": [
    {
      "pattern": "lma.blp.sh",
      "custom_domain": true
    }
  ]
}
